PORT=4000
# Local dev: a real PostgreSQL instance (matches the PRD's architecture).
# Password must be URL-encoded if it contains special characters (@ -> %40, etc).
# For staging/production this points at AWS RDS instead.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/social_cup?schema=public"
JWT_SECRET="change_me_in_production"

# OAuth sign-in — comma-separated list of every audience ("aud" claim) that should
# be accepted for that provider. Google: the Web, iOS, and Android OAuth client IDs
# from Google Cloud Console (all three, since the mobile client can present any of
# them depending on platform). Apple: your Services ID and app Bundle ID.
GOOGLE_CLIENT_IDS="your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com"
APPLE_CLIENT_IDS="com.socialcup.app,com.socialcup.app.signin"

# Stripe (test mode) — from the Stripe dashboard's Developers -> API keys page.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe --print-secret`.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID for the $24.99/month membership product, created once via the Stripe API.
STRIPE_PRICE_ID="price_..."
