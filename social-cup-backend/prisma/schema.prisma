// Prisma schema for Social Cup (PostgreSQL, matching the PRD's architecture)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum AccountStatus {
  VISITOR
  MEMBER
  EXPIRED
  CANCELED
}

enum RedemptionStatus {
  PENDING
  REDEEMED
  EXPIRED
  VOIDED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  // Only set for EMAIL-provider accounts; OAuth signups never receive one.
  passwordHash  String?
  name          String
  role          Role           @default(CUSTOMER)
  accountStatus AccountStatus  @default(VISITOR)
  // The method this account was created with. Sign-in is locked to this provider —
  // see /api/auth/oauth/:provider/signin — so an account can't be hijacked by
  // signing in through a different provider that happens to share the same email.
  authProvider  AuthProvider   @default(EMAIL)
  // The provider's stable subject id (Google/Apple `sub` claim). Null for EMAIL accounts.
  providerUserId String?
  // 1 credit = $1. Members get 30/month per the plan; resets on renewal, never rolls over.
  credits       Int            @default(0)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // Set true once the member cancels; access/credits still last until subscriptionCurrentPeriodEnd
  // per the PRD's "cancel takes effect at period end" rule — Stripe's `customer.subscription.deleted`
  // webhook (fired when the period actually ends) is what flips accountStatus to CANCELED.
  subscriptionCancelAtPeriodEnd Boolean  @default(false)
  subscriptionCurrentPeriodEnd  DateTime? @db.Timestamptz(3)
  neighborhood  String?        @default("Bishop Arts")
  preferences   String[]       @default([]) // coffee preferences (matcha, espresso, cold brew, latte)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  redemptions   Redemption[]
  reviews       Review[]
  voidedRedemptions Redemption[] @relation("VoidedBy")

  @@unique([authProvider, providerUserId])
}

model Cafe {
  id           String         @id @default(uuid())
  name         String
  neighborhood String
  address      String
  latitude     Float?
  longitude    Float?
  hours        String
  isOpen       Boolean        @default(true)
  priceTier    String         @default("$$")
  payoutRate   Float          @default(3.50)
  pinCode      String         @default("4821")
  // Bumped whenever the PIN is reset, so every previously trusted device is signed out at once.
  pinVersion   Int            @default(1)
  isFeatured   Boolean        @default(false)
  vibeTags     String[]       @default([])
  // A short one-line perk shown to help members choose, e.g. "Free WiFi + 10% off pastries."
  perkLine     String?
  image        String?
  gallery      String[]       @default([])
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  drinks       Drink[]
  redemptions  Redemption[]
  payouts      Payout[]
  reviews      Review[]
}

model Drink {
  id           String         @id @default(uuid())
  cafeId       String
  name         String
  description  String
  creditsCost  Int
  retailPrice  Float
  isSignature  Boolean        @default(false)
  isEnabled    Boolean        @default(true)
  category     String         @default("Espresso drink")
  image        String?
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)

  cafe         Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  redemptions  Redemption[]
  reviews      Review[]
}

model Redemption {
  id              String           @id @default(uuid())
  code            String
  backupCode      String
  userId          String
  cafeId          String
  drinkId         String
  creditsDeducted Int
  status          RedemptionStatus @default(PENDING)
  // Cafe's payout rate copied at the moment of redemption, so a later rate change
  // never rewrites a past month's statement.
  payoutRateSnapshot Float?
  expiresAt       DateTime         @db.Timestamptz(3)
  redeemedAt      DateTime?        @db.Timestamptz(3)
  voidReason      String?
  voidedById      String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id])
  cafe            Cafe             @relation(fields: [cafeId], references: [id])
  drink           Drink            @relation(fields: [drinkId], references: [id])
  voidedBy        User?            @relation("VoidedBy", fields: [voidedById], references: [id])
}

model Payout {
  id                String       @id @default(uuid())
  cafeId            String
  billingPeriod     String // e.g. "2026-08"
  totalRedemptions  Int
  totalCredits      Int
  amountOwed        Float
  status            PayoutStatus @default(PENDING)
  reference         String?
  paidAt            DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)

  cafe              Cafe         @relation(fields: [cafeId], references: [id])

  @@unique([cafeId, billingPeriod])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  cafeId    String
  drinkId   String
  stars     Int
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id])
  cafe      Cafe     @relation(fields: [cafeId], references: [id])
  drink     Drink    @relation(fields: [drinkId], references: [id])

  @@unique([userId, drinkId])
}
